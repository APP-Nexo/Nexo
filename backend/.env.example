NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://nexo:nexo@localhost:5433/nexo?schema=public
POSTGRES_USER=nexo
POSTGRES_PASSWORD=
POSTGRES_DB=nexo
# Optional in Compose: use an owner for migrations and a DML-only role for the API.
MIGRATION_DATABASE_URL=
APP_DATABASE_URL=
BACKUP_DATABASE_URL=
API_BIND_ADDRESS=127.0.0.1

# Generate a random value with at least 32 characters.
SECRET=
TOKEN_TYPE=Bearer
TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
JWT_ISSUER=nexo-api
JWT_AUDIENCE=nexo-app

CORS_ORIGINS=http://localhost:3000,http://localhost:8081
TRUST_PROXY=

MASTER_EMAIL=
MASTER_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
APP_URL=http://localhost:8081

IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
IGDB_CACHE_TTL_MINUTES=1440

# TLS is optional. Prefer terminating TLS at the reverse proxy.
TLS_KEY_PATH=
TLS_CERT_PATH=

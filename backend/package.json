{
    "name": "backend",
    "version": "2.0.0",
    "environment": "development",
    "description": "",
    "type": "module",
    "main": "./dist/src/server.js",
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "start": "node dist/src/server.js",
        "dev": "nodemon --watch src --exec tsx src/server.ts",
        "migrate": "npx prisma migrate dev --name",
        "migrate:deploy": "npx prisma migrate deploy",
        "generate": "npx prisma generate",
        "sync:version": "tsx prisma/seeds/version.ts",
        "sync:roles": "tsx prisma/seeds/roles.ts",
        "sync:master": "tsx prisma/seeds/master.ts",
        "sync:seeds": "tsx prisma/seeds/index.ts",
        "sync:games": "tsx src/scripts/sync-games.ts",
        "sync:games:prod": "node dist/src/scripts/sync-games.js",
        "start:prod": "npm start",
        "test": "NODE_ENV=test vitest run --reporter=verbose",
        "test:ci": "npm run migrate:deploy && npm run sync:seeds && npm test",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "format": "biome check --write .",
        "format:check": "biome ci ."
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "engines": {
        "node": "^22.12.0 || >=24.0.0"
    },
    "dependencies": {
        "@fastify/cors": "11.3.0",
        "@fastify/jwt": "10.2.2",
        "@fastify/multipart": "10.1.1",
        "@fastify/rate-limit": "11.2.0",
        "@fastify/static": "10.1.3",
        "@fastify/swagger": "9.8.1",
        "@fastify/swagger-ui": "6.1.1",
        "@prisma/adapter-pg": "7.9.1",
        "@prisma/client": "7.9.1",
        "argon2": "^0.41.1",
        "dotenv": "17.3.1",
        "fast-jwt": "6.3.2",
        "fastify": "5.12.1",
        "nodemailer": "9.0.5",
        "pg": "8.20.0",
        "pino": "9.14.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.10",
        "@types/node": "25.5.0",
        "@types/nodemailer": "8.0.1",
        "@types/pg": "8.18.0",
        "@vitest/coverage-v8": "4.1.11",
        "nodemon": "3.1.14",
        "pino-pretty": "13.1.3",
        "prisma": "7.9.1",
        "tsx": "4.23.12",
        "typescript": "5.9.3",
        "vitest": "4.1.11"
    },
    "overrides": {
        "brace-expansion": "5.0.9",
        "deepmerge-ts": "8.0.2",
        "minimatch": "10.2.6"
    }
}

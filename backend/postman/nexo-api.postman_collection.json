{
    "info": {
        "name": "Nexo API",
        "description": "Collection for the current Nexo API. Set the collection variables before running protected or admin requests.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://127.0.0.1:3000/api",
            "type": "string",
            "description": "Local Docker API base URL."
        },
        {
            "key": "token",
            "value": "",
            "type": "string",
            "description": "Access token captured by register, login or refresh."
        },
        {
            "key": "refreshToken",
            "value": "",
            "type": "string",
            "description": "Refresh token captured by register, login or refresh."
        },
        {
            "key": "adminToken",
            "value": "",
            "type": "string",
            "description": "Paste an admin or master access token here."
        },
        {
            "key": "masterToken",
            "value": "",
            "type": "string",
            "description": "Paste a master access token here."
        },
        {
            "key": "username",
            "value": "johndoe",
            "type": "string"
        },
        {
            "key": "email",
            "value": "john@example.com",
            "type": "string"
        },
        {
            "key": "password",
            "value": "SecurePass123!",
            "type": "string"
        },
        {
            "key": "newPassword",
            "value": "NewSecurePass123!",
            "type": "string"
        },
        {
            "key": "targetUsername",
            "value": "janedoe",
            "type": "string"
        },
        {
            "key": "friendlyId",
            "value": "replace-with-friendly-id",
            "type": "string"
        },
        {
            "key": "userId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "gameId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "reviewId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "reportId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "notificationId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "listId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "cursor",
            "value": "1",
            "type": "string"
        },
        {
            "key": "limit",
            "value": "20",
            "type": "string"
        }

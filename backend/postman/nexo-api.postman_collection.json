                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "username",
                                    "value": "{{username}}",
                                    "type": "text"
                                },
                                {
                                    "key": "bio",
                                    "value": "Updated from Postman",
                                    "type": "text"
                                },
                                {
                                    "key": "photo",
                                    "type": "file",
                                    "src": "",
                                    "disabled": true
                                },
                                {
                                    "key": "banner",
                                    "type": "file",
                                    "src": "",
                                    "disabled": true
                                }
                            ]
                        },
                        "url": "{{baseUrl}}/me"
                    }
                },
                {
                    "name": "PUT /me/password",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"currentPassword\": \"{{password}}\",\n    \"newPassword\": \"{{newPassword}}\"\n}"
                        },
                        "url": "{{baseUrl}}/me/password"
                    }
                },
                {
                    "name": "DELETE /me (destructive)",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"password\": \"{{password}}\"\n}"
                        },
                        "url": "{{baseUrl}}/me"
                    }
                }
            ]
        },

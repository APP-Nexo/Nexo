# Leave EXPO_PUBLIC_API_URL unset for local dev — the API URL is now derived
# automatically from wherever the Expo dev server is being reached from (see
# services/api.ts), so it adapts on its own when your LAN IP changes. Only
# set this if you need to point at something else, like a deployed backend.
# EXPO_PUBLIC_API_URL=http://localhost:3000/api

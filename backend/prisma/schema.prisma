// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int          @id @default(autoincrement())
  name      String
  email     String       @unique
  password  String
  createdAt DateTime     @default(now())
  activate  Boolean      @default(true)
  access    String

  profile   UserProfile?
}

model UserProfile {
  id       Int     @id @default(autoincrement())
  photo    String?
  banner   String?
  config   Json?
  userId   Int     @unique
  user     User    @relation(fields: [userId], references: [id])
}

// views

view VwUserPublic {
  id        Int      @unique
  name      String
  email     String
  createdAt DateTime
  photo     String?
  banner    String?
  config    Json?

  @@map("vw_user_public")
}

view VwUsersStatusSummary {
  totalAtivos   Int @map("total_ativos")
  totalInativos Int @map("total_inativos")
  totalGeral    Int @map("total_geral")

  @@map("vw_users_status_summary")
}
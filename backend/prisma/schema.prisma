generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

model AppVersion {
  id         Int      @id @default(autoincrement())
  appVersion String   
  dbVersion  String   
  timestamp  DateTime @default(now()) 

  @@unique([appVersion, dbVersion])
}

model Role {
  id    Int    @id @default(autoincrement())
  role  String @unique
  
  users User[]
}

model User {
  id        Int          @id @default(autoincrement())
  username  String?      @unique
  email     String       @unique
  password  String
  createdAt DateTime     @default(now())
  deletedAt DateTime?   
  activate  Boolean      @default(true)
  roleId    Int

  role      Role         @relation(fields: [roleId], references: [id])
  profile   UserProfile?
  following      UserFollow[]   @relation("follower")
  followers      UserFollow[]   @relation("following")
  notificationsReceived Notification[] @relation("toUser")
  notificationsSent     Notification[] @relation("fromUser")
  reviews        Review[]
  gameLists      UserGameList[]
  blockedUser    BlockedUser?    @relation("Blocked")
  blockedBy      BlockedUser[]   @relation("Blocker")
  reportsMade    Report[]        @relation("Reporter")
}

model UserProfile {
  id             Int       @id @default(autoincrement())
  friendlyId     String    @unique @default(cuid()) 
  photo          String?
  banner         String?
  config         Json?
  bio            String?
  userId         Int       @unique
  followersCount Int       @default(0) 
  followingCount Int       @default(0)
  
  user     User    @relation(fields: [userId], references: [id])
}

model UserFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  timestamp   DateTime @default(now())

  follower    User @relation("follower", fields: [followerId], references: [id])
  following   User @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Notification {
  id         Int      @id @default(autoincrement())
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  toUserId   Int
  fromUserId Int

  toUser     User     @relation("toUser",   fields: [toUserId],   references: [id])
  fromUser   User     @relation("fromUser", fields: [fromUserId], references: [id])
}

model Game {
  id            Int      @id @default(autoincrement())
  title         String
  cover         String?
  description   String?
  releaseDate   DateTime?
  genre         String?
  averageRating Float    @default(0)
  createdAt     DateTime @default(now())

  reviews        Review[]
  listItems      UserGameListItem[]

  @@index([title])
}

enum ReviewStatus {
  pending
  approved
  rejected
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  gameId    Int
  rating    Int
  text      String?
  status    ReviewStatus @default(pending)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id])
  game       Game     @relation(fields: [gameId], references: [id])
  reports    Report[]

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
  @@index([status])
}

model UserGameList {
  id       Int    @id @default(autoincrement())
  userId   Int
  name     String
  isPublic Boolean @default(true)

  user  User   @relation(fields: [userId], references: [id])
  items UserGameListItem[]

  @@unique([userId, name])
}

model UserGameListItem {
  id      Int      @id @default(autoincrement())
  listId  Int
  gameId  Int
  addedAt DateTime @default(now())

  list UserGameList @relation(fields: [listId], references: [id])
  game Game         @relation(fields: [gameId], references: [id])

  @@unique([listId, gameId])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())



  @@index([email])
}

model BlockedUser {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  blockedById Int
  reason      String?
  createdAt   DateTime @default(now())

  user      User @relation("Blocked", fields: [userId], references: [id])
  blockedBy User @relation("Blocker", fields: [blockedById], references: [id])

  @@index([blockedById])
}

enum ReportStatus {
  pending
  resolved
  rejected
}

model Report {
  id         Int      @id @default(autoincrement())
  reporterId Int
  reviewId   Int
  reason     String
  status     ReportStatus @default(pending)
  createdAt  DateTime @default(now())

  reporter User   @relation("Reporter", fields: [reporterId], references: [id])
  review   Review @relation(fields: [reviewId], references: [id])

  @@index([status])
}

view VwUserPublic {
  id         Int      @unique
  friendlyId String?  @unique 
  email      String   @unique
  createdAt  DateTime
  roleId     Int     
  photo      String?
  banner     String?
  config     Json?
  bio        String?
  followersCount Int?
  followingCount Int?

  @@map("vw_user_public")
}

view VwUsersStatusSummary {
  totalUsers        Int 
  totalActive       Int 
  totalDeactivated  Int 
  totalAdmins       Int 
  totalRegularUsers Int 

  @@map("vw_users_status_summary")
}
{
	"name": "backend",
	"version": "1.0.0",
	"environment": "development",
	"description": "",
	"type": "module",
	"main": "./src/server.ts",
	"scripts": {
		"tsc": "tsc --init",
		"start": "nodemon --watch src --exec tsx src/server.ts",
		"dev": "nodemon --watch src --exec tsx src/server.ts",
		"migrate": "npx prisma migrate dev --name",
		"generate": "npx prisma generate",
		"dbpush": "npx prisma db push",
		"sync:version": "tsx prisma/seeds/version.ts",
		"sync:roles": "tsx prisma/seeds/roles.ts",
		"sync:master": "tsx prisma/seeds/master.ts",
		"sync:seeds": "tsx prisma/seeds/index.ts",
		"start:prod": "npx prisma migrate deploy && npm start",
		"test": "NODE_ENV=test vitest run --reporter=verbose",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@fastify/cors": "9.0.1",
		"@fastify/jwt": "8.0.1",
		"@fastify/swagger": "8.15.0",
		"@fastify/swagger-ui": "4.2.0",
		"@prisma/adapter-pg": "7.4.2",
		"@prisma/client": "7.4.2",
		"bcrypt": "6.0.0",
		"dotenv": "17.3.1",
		"fastify": "4.28.1",
		"multer": "2.1.1",
		"pg": "8.20.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@types/bcrypt": "5.0.2",
		"@types/node": "25.5.0",
		"@types/pg": "8.18.0",
		"@vitest/coverage-v8": "2.1.8",
		"nodemon": "3.1.14",
		"pino-pretty": "13.1.3",
		"prisma": "7.4.2",
		"tsx": "4.21.0",
		"typescript": "5.9.3",
		"vitest": "2.1.8"
	}
}
